<Window x:Class="KeyShot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyShot" Width="380" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" Icon="/Assets/keyshot.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The hero toggle: filled accent when it will ENABLE, outlined when it will DISABLE. -->
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#0D0E11" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="12" BorderThickness="1.5"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="B" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Grid Height="36" DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/keyshot.ico" Width="16" Height="16" />
                    <TextBlock Text="KeyShot" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close to tray" />
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,4,24,20">
                    <!-- Header: title left, live status right -->
                    <Grid>
                        <TextBlock Text="KEYSHOT" FontFamily="{StaticResource DisplayFont}" FontSize="30" Foreground="{StaticResource Text}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,4" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentDim}" />
                                            <Setter Property="BorderBrush" Value="#5A2E17" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding AudioWarning}" Foreground="#FF8A65" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Controls card: label | slider | value on one row each -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="14" Padding="16,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="46" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Volume" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" AutomationProperties.Name="Volume" />
                            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}" Style="{StaticResource Value}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="Variation" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Variation}" VerticalAlignment="Center" AutomationProperties.Name="Variation" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Variation, StringFormat={}{0}%}" Style="{StaticResource Value}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="Cooldown" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="250" Value="{Binding Cooldown}" VerticalAlignment="Center" AutomationProperties.Name="Cooldown" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Cooldown, StringFormat={}{0} ms}" Style="{StaticResource Value}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Text="Mode" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                                      VerticalAlignment="Center" AutomationProperties.Name="Mode" />

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <CheckBox Content="Heavy Space" IsChecked="{Binding HeavySpace}" Margin="0,0,20,0" />
                                <CheckBox Content="Strong Enter" IsChecked="{Binding StrongEnter}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Power + test -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PowerButton}" Click="Toggle_Click"
                                Content="{Binding ToggleText}" AutomationProperties.Name="Enable or disable KeyShot" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Width="56" Height="56"
                                Click="Test_Click" ToolTip="Test shot" AutomationProperties.Name="Test shot"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Content="&#xE768;" />
                    </Grid>

                    <!-- Info -->
                    <Grid Margin="2,14,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Hotkey" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding HotkeyText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="11"
                                Content="{Binding HotkeyButtonText}" Click="ChangeHotkey_Click" />

                        <TextBlock Grid.Row="1" Text="Audio" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DeviceText}" FontSize="12"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DeviceText}" />

                        <TextBlock Grid.Row="2" Text="Version" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersionText}" FontSize="12"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
